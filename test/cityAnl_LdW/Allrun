if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--nomesh" ]; }; then
    echo "Usage: $0 [--nomesh]" >&2
    exit 2
fi

if [ "$#" -eq 0 ]; then
    mv LdW.stl constant/geometry/
    echo "Stl file moved to constant/geometry/"
    surfaceCheck constant/geometry/LdW.stl
    rm LdW*.obj

    surfaceFeatures

    python makeCase.py

    blockMesh > log.blockMesh

    snappyHexMesh -overwrite

    checkMesh > log.checkMesh
fi

simpleFoam > log.simpleFoam

foamToVTK -latestTime > log.foamToVTK
../../utils/vizStreamLines.py "./" xy > log.vizStreamLines 2>&1 && rm log.vizStreamLines

fslFoam > log.fslFoam

refOFCase=LdW
mv $refOFCase.png ./postProcessing/$refOFCase/
