/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM dictionary for city obstacle mesh generation.                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

meshDomain
{
    horizontalOffset 20;
}

geometry
{
    LdW.stl
    {
        type triSurfaceMesh;
        name ground;
    }

    refinementBox
    {
        type searchableBox;
        min (487700 5876075 0);
        max (488550 5876650 80);
    }
}

castellatedMesh true;
snap true;
addLayers false;

castellatedMeshControls
{
    maxLocalCells  1000000;
    maxGlobalCells 3000000;
    minRefinementCells 10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    features
    (
        {
            file "LdW.extendedFeatureEdgeMesh";
            level 2;
        }
    );

    refinementSurfaces
    {
        ground
        {
            level (2 3);
        }
    }

    refinementRegions
    {
        refinementBox
        {
            mode inside;
            level 1;
        }
    }

    locationInMesh
    (
        487726.779205 5876357.03636 20
    );
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 10;
    nRelaxIter 5;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol -1e30;
    minTetQuality 1e-15;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;