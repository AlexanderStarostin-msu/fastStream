FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

#include "./system/inputParameters"

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform ($Ux $Uy 0); 
boundaryField
{
    // Updated by bndFromMap.py at 2026-10-30T21:43:11Z (UTC)
    ground
    {
        type noSlip;
    }

    inlet
    {
        type fixedValue;        value uniform ($U 0 0);
    }

    outlet
    {
        type zeroGradient;
    }

    sides
    {
        type symmetry;
    }

    top
    {
        type symmetry;
    }
}
