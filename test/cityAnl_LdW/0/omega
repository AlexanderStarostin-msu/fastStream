FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    // Updated by bndFromMap.py at 2026-10-25T20:14:40Z (UTC)
        ground
    {
        type omegaWallFunction;       value uniform 1.0;
    }

        inlet
    {
        type fixedValue;    value uniform 1.0;
    }

        outlet
    {
        type fixedValue;    value uniform 1.0;
    }

        sides
    {
        type fixedValue;    value uniform 1.0;
    }

        top
    {
        type symmetryPlane;
    }
}
