# Mesh patches: inlet, outlet, sides, top, ground.
# Assumptions: beta is a clockwise bearing from north for the direction the
# wind travels toward; beta_deg=90 therefore gives flow in +x (east).
# No reference wind speed is supplied, so inlet speed is normalized to 1 m/s.
# Turbulence entries assume a standard k-epsilon RANS model and 5% inlet
# turbulence intensity. 
inlet:
    U:  type inletOutlet;        value uniform ($Ux $Uy 0);   inletValue uniform ($Ux $Uy 0);
    p:  type zeroGradient;
    k:  type fixedValue;        value uniform 0.00375;
    epsilon:    type fixedValue;    value uniform 0.000004;
    omega:      type fixedValue;    value uniform 1.0;
    nut:        type calculated;      value uniform 0;
outlet:
    U:  type inletOutlet;        value uniform ($Ux $Uy 0);   inletValue uniform ($Ux $Uy 0);
    p:  type zeroGradient;
    k:  type fixedValue;        value uniform 0.00375;
    epsilon:    type fixedValue;    value uniform 0.000004;
    omega:      type fixedValue;    value uniform 1.0;
    nut:        type calculated;      value uniform 0;
sides:
    U:  type inletOutlet;        value uniform ($Ux $Uy 0);   inletValue uniform ($Ux $Uy 0);
    p:  type zeroGradient;
    k:  type fixedValue;        value uniform 0.00375;
    epsilon:    type fixedValue;    value uniform 0.000004;
    omega:      type fixedValue;    value uniform 1.0;
    nut:        type calculated;      value uniform 0;
top:
    U:   type symmetryPlane;
    p:   type symmetryPlane;
    k:   type symmetryPlane;
    epsilon:      type symmetryPlane;
    omega:        type symmetryPlane;
    nut:          type symmetryPlane;
ground:
    U:    type noSlip;
    p:    type zeroGradient;
    k:    type kqRWallFunction;        value uniform 0.00375;
    epsilon:    type epsilonWallFunction;     value uniform 0.000004;
    omega:      type omegaWallFunction;       value uniform 1.0;
    nut:        type nutkWallFunction;        value uniform 0;
