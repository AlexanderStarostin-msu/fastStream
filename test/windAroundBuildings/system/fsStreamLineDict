/*--------------------------------*- C++ -*----------------------------------*\
| fsFoam input: copy this file into the analysis case's system directory.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fsStreamLineDict;
}

case "./";

// Defaults: one inlet start patch and one outlet destination patch.
startPatches        (inlet);
destinationPatches  (outlet);

// Flight corridor is 10-20 m above ground, below the tallest 50 m buildings.
minHeight           5;
maxHeight           25;

// Shared solver and grid-slice minimum clearance from obstacle surfaces.
minObstacleClearance 5;
obstaclePatches        (ground);

// Number of area-weighted seed points over the selected start patches.
nPoints             100;
lifeTime            100000;
nSubCycle           5;

outputStreamLines on;

// Regenerate the mesh using snappyHexMeshDict so building walls are included
// in the ground obstacle patch.
// Zermelo uses the shared nPoints value above; lifeTime and nSubCycle apply
// only to flow streamline integration.
ZermeloTrjNoFlow
{
     deviceSpeed         0.1;
     variableHeight      false;
}
